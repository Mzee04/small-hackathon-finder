# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
ADMIN_TELEGRAM_USER_ID=5068461324

# SQLite path (Docker default mounts ./data)
DATABASE_PATH=./data/bot.sqlite

# Polling (public RPCs rate-limit aggressively — keep conservative)
POLL_INTERVAL_MS=12000
BLOCK_BATCH_SIZE=4
CHAIN_DELAY_MS=500
REQUEST_TIMEOUT_MS=12000
ENABLED_CHAINS=ethereum,base,arbitrum,optimism,polygon,bsc,avalanche,robinhood,ink

# Optional: override public RPCs (still falls back to chains.json rpcUrls)
# Defaults prefer free endpoints that allow logs/receipts without paid keys
# (drpc / chain-official). PublicNode is kept as fallback — the poller uses
# eth_getBlockReceipts so it does not need unrestricted eth_getLogs.
# RPC_ETHEREUM=https://eth.drpc.org
# RPC_BASE=https://base.drpc.org
# RPC_ARBITRUM=https://arb1.arbitrum.io/rpc
# RPC_OPTIMISM=https://optimism.drpc.org
# RPC_POLYGON=https://polygon.drpc.org
# RPC_BSC=https://bsc.drpc.org
# RPC_AVALANCHE=https://api.avax.network/ext/bc/C/rpc
# RPC_ROBINHOOD=https://rpc.mainnet.chain.robinhood.com
# RPC_INK=https://rpc-gel.inkonchain.com

# Dry-run: load config + DB + start Telegram bot, skip chain polling
# DRY_RUN=1
