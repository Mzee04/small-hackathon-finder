# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
ADMIN_TELEGRAM_USER_ID=5068461324

# SQLite path (Docker default mounts ./data)
DATABASE_PATH=./data/bot.sqlite

# Polling (public RPCs rate-limit aggressively — keep conservative)
POLL_INTERVAL_MS=15000
BLOCK_BATCH_SIZE=5
CHAIN_DELAY_MS=800
REQUEST_TIMEOUT_MS=20000
ENABLED_CHAINS=ethereum,base,arbitrum,optimism,polygon,bsc,avalanche,robinhood,ink

# Optional: override public RPCs with Alchemy / QuickNode / Infura
# RPC_ETHEREUM=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# RPC_BASE=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
# RPC_ARBITRUM=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
# RPC_OPTIMISM=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY
# RPC_POLYGON=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
# RPC_BSC=https://YOUR_QUICKNODE.bsc.quiknode.pro/YOUR_KEY/
# RPC_AVALANCHE=https://YOUR_QUICKNODE.avalanche-mainnet.quiknode.pro/YOUR_KEY/
# RPC_ROBINHOOD=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY
# RPC_INK=https://rpc-gel.inkonchain.com

# Dry-run: load config + DB + start Telegram bot, skip chain polling
# DRY_RUN=1
